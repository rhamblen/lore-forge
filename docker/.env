# Lore Forge — live config for this stack.
# Shipped ready to use: copy docker/ to the server and adjust the paths below.
# Holds no secrets. If you ever add a credential, move it out of version control.
# ---------------------------------------------------------------------------

# Ollama (external, on the LAN). This is the `ollama` container on its own br0
# macvlan at .32 — NOT UR1's own address (.33). It runs on the spare GPU precisely
# so ComfyUI keeps the 3090 to itself.
OLLAMA_URL=http://192.168.1.32:11434

# Embedding model for the index (L1). MUST be pulled on the box above:
#   curl -s http://192.168.1.32:11434/api/pull -d '{"name":"nomic-embed-text"}'
# nomic-embed-text  768 dims, ~275 MB   — fast, the default
# bge-m3           1024 dims, ~1.2 GB   — longer context, better on book-length prose
# Changing this after indexing a book does NOT silently corrupt anything: the model
# and its dimension are recorded per book, and a mismatched query is refused with a
# "reindex needed" error rather than returning nonsense.
EMBED_MODEL=nomic-embed-text

# Generation model for the extraction passes (L2 onwards). Unused at 0.1.x.
# 8-14B is explicitly enough for extraction; the 70B GM brain is a separate,
# hardware-gated concern and does not belong here.
OLLAMA_MODEL=gemma3:12b

# Output tree — a SIBLING of comfyui-builds on the same share. Lore Forge owns this
# folder outright; Persona Forge reads from it at merge time (L6) but never writes.
# Keep this path free of spaces. Do NOT wrap it in quotes — docker compose would
# treat the quotes as part of the value.
LORE_BUILDS_HOST_PATH=/mnt/user/data-and-backups/blender-and-comfyui-output/lore-builds

# Persistent state. These sit as PEERS of the docker/ folder:
#   /mnt/user/appdata/lore-forge/{docker,db,logs}
#
# USE ABSOLUTE PATHS. A relative path is resolved against docker compose's
# *project directory*, which Unraid's Compose Manager does not always set to this
# file's folder.
DB_HOST_PATH=/mnt/user/appdata/lore-forge/db
LOGS_HOST_PATH=/mnt/user/appdata/lore-forge/logs

# Port Lore Forge is published on. 8890 is Persona Forge — do not collide.
LF_PORT=8891

# Ownership for folders Lore Forge creates in the shared tree.
PUID=99
PGID=100

TZ=Europe/London
